    { "name": "REQ3-11 Amount at policy limit", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"claimId\":\"SYN-REQ3-11\",\"customerId\":\"SYN-C-011\",\"vehicleNumber\":\"SYN-V-011\",\"claimAmount\":1000,\"policyLimit\":1000,\"policyStatus\":\"ACTIVE\"}" }, "url": "{{baseUrl}}/claims" } },
    { "name": "REQ3-12 Forged document marker characterization", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"claimId\":\"SYN-REQ3-12\",\"customerId\":\"SYN-C-012\",\"vehicleNumber\":\"SYN-V-012\",\"claimAmount\":500,\"policyLimit\":1000,\"policyStatus\":\"ACTIVE\",\"forgedDocumentTestMarker\":\"SYN-FORGED-DOC-012\"}" }, "url": "{{baseUrl}}/claims" } },
    { "name": "REQ3-13 Expired policy", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"claimId\":\"SYN-REQ3-13\",\"customerId\":\"SYN-C-013\",\"vehicleNumber\":\"SYN-V-013\",\"claimAmount\":500,\"policyLimit\":1000,\"policyStatus\":\"EXPIRED\"}" }, "url": "{{baseUrl}}/claims" } },
    { "name": "REQ3-14 Both implemented rules", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"claimId\":\"SYN-REQ3-14\",\"customerId\":\"SYN-C-014\",\"vehicleNumber\":\"SYN-V-014\",\"claimAmount\":1001,\"policyLimit\":1000,\"policyStatus\":\"EXPIRED\"}" }, "url": "{{baseUrl}}/claims" } },
