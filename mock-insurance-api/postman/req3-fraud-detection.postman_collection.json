{
  "info": {
    "name": "Req3 Fraud Detection Validation",
    "description": "Contains 21 ordered requests and a saved collection-level post-response test script that executes one named assertion per request (21 assertions total). These characterize available mock API behavior; acceptance of marker/repeat cases is not evidence that Req3 fraud detection is implemented.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const requestName = pm.info.requestName;",
          "const scenario = requestName.match(/REQ3-\\d+/)[0];",
          "const method = pm.request.method;",
          "const response = pm.response.json();",
          "if (method === 'GET' && scenario === 'REQ3-15') {",
          "  pm.test(scenario + ': retrieves existing claim', function () {",
          "    pm.response.to.have.status(200);",
          "    pm.expect(response.claimId).to.eql('SYN-REQ3-01');",
          "    pm.expect(response.customerId).to.eql('SYN-C-001');",
          "  });",
          "} else if (method === 'GET' && scenario === 'REQ3-16') {",
          "  pm.test(scenario + ': missing claim returns 404', function () {",
          "    pm.response.to.have.status(404);",
          "    pm.expect(response).to.eql({ message: 'Claim not found' });",
          "  });",
          "} else {",
          "  const submitted = JSON.parse(pm.request.body.raw);",
          "  let expectedStatus = 'ACCEPTED';",
          "  let expectedRule = null;",
          "  if (scenario === 'REQ3-10' && submitted.claimAmount > submitted.policyLimit) {",
          "    expectedStatus = 'FLAGGED';",
          "    expectedRule = 'RULE-001';",
          "  }",
          "  if (submitted.policyStatus === 'EXPIRED') {",
          "    expectedStatus = 'FLAGGED';",
          "    expectedRule = 'RULE-002';",
          "  }",
          "  pm.test(scenario + ': POST characterization matches implemented response', function () {",
          "    pm.response.to.have.status(201);",
          "    pm.expect(response).to.eql({ claimId: submitted.claimId, status: expectedStatus, fraudRule: expectedRule });",
          "  });",
          "}",
          ""
        ]
      }
    }
  ],
  "item": [
    { "name": "REQ3-01 Baseline", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"claimId\":\"SYN-REQ3-01\",\"customerId\":\"SYN-C-001\",\"vehicleNumber\":\"SYN-V-001\",\"claimAmount\":500,\"policyLimit\":1000,\"policyStatus\":\"ACTIVE\"}" }, "url": "{{baseUrl}}/claims" } },
    { "name": "REQ3-02 Duplicate first submission", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"claimId\":\"SYN-REQ3-02-DUP\",\"customerId\":\"SYN-C-002\",\"vehicleNumber\":\"SYN-V-002\",\"claimAmount\":500,\"policyLimit\":1000,\"policyStatus\":\"ACTIVE\"}" }, "url": "{{baseUrl}}/claims" } },
    { "name": "REQ3-02 Duplicate second submission", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"claimId\":\"SYN-REQ3-02-DUP\",\"customerId\":\"SYN-C-002\",\"vehicleNumber\":\"SYN-V-002\",\"claimAmount\":500,\"policyLimit\":1000,\"policyStatus\":\"ACTIVE\"}" }, "url": "{{baseUrl}}/claims" } },
