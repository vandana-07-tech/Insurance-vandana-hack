      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"claimId\":\"SYN-CLM-006\",\"policyNumber\":\"POL-SYN-006\",\"customerId\":\"CUS-SYN-006\",\"vehicleNumber\":\"VEH-SYN-006\",\"accidentDate\":\"2026-09-15\",\"claimAmount\":2500,\"claimType\":\"COLLISION\",\"policyLimit\":10000,\"policyStatus\":\"ACTIVE\"}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/claims"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('CLM-006 characterizes duplicate acceptance', function () {", "  pm.response.to.have.status(201);", "  pm.expect(pm.response.json()).to.deep.equal({ claimId: 'SYN-CLM-006', status: 'ACCEPTED', fraudRule: null });", "});"] } }]
    },
    {
      "name": "CLM-016 Retrieve created claim",
      "request": { "method": "GET", "url": "{{baseUrl}}/claims/SYN-CLM-001" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('CLM-016 retrieves created claim', function () {", "  pm.response.to.have.status(200);", "  pm.expect(pm.response.json().claimId).to.eql('SYN-CLM-001');", "});"] } }]
    },
    {
      "name": "CLM-017 Retrieve unknown claim",
      "request": { "method": "GET", "url": "{{baseUrl}}/claims/SYN-CLM-017" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('CLM-017 returns not found', function () {", "  pm.response.to.have.status(404);", "  pm.expect(pm.response.json()).to.deep.equal({ message: 'Claim not found' });", "});"] } }]
    }
