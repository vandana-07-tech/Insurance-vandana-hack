  "item": [
    {
      "name": "01 - Submit Genuine Claim",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              " \r",
              "const response = pm.response.json();\r",
              " \r",
              "pm.test(\"Claim is accepted\", function () {\r",
              "    pm.expect(response.status).to.eql(\"ACCEPTED\");\r",
              "});\r",
              " \r",
              "pm.test(\"No fraud rule triggered\", function () {\r",
              "    pm.expect(response.fraudRule).to.eql(null);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"claimId\": \"CLM1001\",\r\n    \"policyId\": \"POL1001\",\r\n    \"customerId\": \"CUS1001\",\r\n    \"claimAmount\": 50000,\r\n    \"policyLimit\": 100000,\r\n    \"policyStatus\": \"ACTIVE\",\r\n    \"incidentDate\": \"2026-09-15\"\r\n}",
          "options": {
